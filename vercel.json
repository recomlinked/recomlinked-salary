{
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },

    { "src": "/favicon.ico", "dest": "/favicon.svg" },
    { "src": "/robots.txt",  "dest": "/robots.txt"  },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },

    { "src": "/raise",                "status": 301, "headers": { "Location": "/raise/" }           },
    { "src": "/raise/",               "dest": "/raise/index.html"           },
    { "src": "/raise/chat",           "status": 301, "headers": { "Location": "/raise/chat/" }      },
    { "src": "/raise/chat/",          "dest": "/raise/chat/index.html"      },
    { "src": "/raise/paid",           "status": 301, "headers": { "Location": "/raise/paid/" }      },
    { "src": "/raise/paid/",          "dest": "/raise/paid/index.html"      },
    { "src": "/raise/enter",          "status": 301, "headers": { "Location": "/raise/enter/" }     },
    { "src": "/raise/enter/",         "dest": "/raise/enter/index.html"     },
    { "src": "/raise/waitlist",       "status": 301, "headers": { "Location": "/raise/waitlist/" }  },
    { "src": "/raise/waitlist/",      "dest": "/raise/waitlist/index.html"  },
    { "src": "/raise/coach",          "status": 301, "headers": { "Location": "/raise/coach/" }     },
    { "src": "/raise/coach/",         "dest": "/raise/coach/index.html"     },

    { "src": "/offer",                 "status": 301, "headers": { "Location": "/offer/" }           },
    { "src": "/offer/",                "dest": "/offer/index.html"           },
    { "src": "/offer/chat",            "status": 301, "headers": { "Location": "/offer/chat/" }      },
    { "src": "/offer/chat/",           "dest": "/offer/chat/index.html"      },

    { "src": "/raise-case",           "status": 301, "headers": { "Location": "/raise-case/" }      },
    { "src": "/raise-case/",          "dest": "/raise-case/index.html"      },

    { "src": "/about",           "status": 301, "headers": { "Location": "/about/" }           },
    { "src": "/about/",          "dest": "/about/index.html"                                   },
    { "src": "/contact",         "status": 301, "headers": { "Location": "/contact/" }         },
    { "src": "/contact/",        "dest": "/contact/index.html"                                 },
    { "src": "/privacy-policy",  "status": 301, "headers": { "Location": "/privacy-policy/" }  },
    { "src": "/privacy-policy/", "dest": "/privacy-policy/index.html"                         },

    { "src": "/", "dest": "/index.html" }
  ],
  "functions": {
    "api/raise-webhook.js":      { "memory": 256 },
    "api/raise-coach.js":        { "memory": 256, "maxDuration": 60 },
    "api/raise-notes-update.js": { "memory": 256, "maxDuration": 30 }
  }
}
